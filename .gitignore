# ══════════════════════════════════════
# CORRIDOOR — Global .gitignore
# ══════════════════════════════════════

# ── Python / Backend ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/
*.db
*.sqlite3

# ── Node / Frontend + Mobile ──
node_modules/
.expo/
dist/
*.tsbuildinfo
.cache/

# ── Environment & Secrets ──
.env
.env.local
.env.production
.env.*.local

# ── OS junk ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build outputs ──
frontend/dist/
frontend/build/
mobile/.expo/
mobile/android/
mobile/ios/